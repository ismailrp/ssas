<!--
  TABULAR - Create persistent XEvent trace session
  Run this via SSMS: connect to the Tabular instance (Analysis Services),
  New Query > MDX/XMLA, paste and execute.

  Captures: total query duration, VertiPaq SE (storage engine) duration,
  DirectQuery duration, and errors. Correlate FE/SE later via ActivityID.
-->
<Create xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
  <ObjectDefinition>
    <Trace>
      <ID>ProdFESE_Monitor</ID>
      <Name>ProdFESE_Monitor</Name>
      <AutoRestart>true</AutoRestart>
      <XEvent>
        <event_session name="ProdFESE_Monitor" xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
          <event package="AS" name="QueryBegin"/>
          <event package="AS" name="QueryEnd"/>
          <event package="AS" name="VertiPaqSEQueryBegin"/>
          <event package="AS" name="VertiPaqSEQueryEnd"/>
          <event package="AS" name="DirectQueryEnd"/>
          <event package="AS" name="Error"/>
          <target package="Package0" name="event_file">
            <parameter name="filename" value="D:\OLAP\Log\ProdFESE_Monitor"/>
            <parameter name="max_file_size" value="100"/>
            <parameter name="max_rollover_files" value="200"/>
          </target>
        </event_session>
      </XEvent>
    </Trace>
  </ObjectDefinition>
</Create>

<!--
  ~~ Sizing note ~~
  max_file_size(MB) x max_rollover_files = total disk cap.
  100MB x 200 files = ~20GB cap. Adjust based on your traffic volume and
  how often the parser will actually run. Monitor disk usage regardless.

  ~~ To stop/remove later ~~
  <Delete xmlns="http://schemas.microsoft.com/analysisservices/2003/engine">
    <Object>
      <TraceID>ProdFESE_Monitor</TraceID>
    </Object>
  </Delete>
-->
